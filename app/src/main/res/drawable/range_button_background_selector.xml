<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/active_range_button_background"/>
            <corners android:radius="5dp"/> <padding
            android:left="5dp"
            android:top="2dp"
            android:right="5dp"
            android:bottom="2dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/inactive_range_button_background"/>
            <corners android:radius="5dp"/> <stroke android:width="1dp" android:color="#707070"/>
            <padding
                android:left="5dp"
                android:top="2dp"
                android:right="5dp"
                android:bottom="2dp" />
        </shape>
    </item>
</selector>